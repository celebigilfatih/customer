// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  SUPPORT
  CUSTOMER
}

enum CustomerStatus {
  POTENTIAL
  ACTIVE
  INACTIVE
  LOST
}

enum SubscriptionType {
  SOFTWARE_RENTAL
  CUSTOM_PROJECT
  MAINTENANCE
  NEXT_GEN_COACHING
  AIDAT_TAKIP
  FOOTBALL_CMS
  DOMAIN
  HOSTING
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum TaskStatus {
  OPEN
  PENDING
  DONE
}

enum PaymentStatus {
  DUE
  LATE
  PAID
  CANCELLED
}

enum PaymentType {
  CASH
  TRANSFER
  CREDIT_CARD
}

enum NotificationType {
  DOMAIN_RENEWAL
  HOSTING_RENEWAL
  SUBSCRIPTION_PAYMENT
  MAINTENANCE_EXPIRY
  ADMIN_REMINDER
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum ProposalStatus {
  DRAFT
  SENT
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum ProposalType {
  SUBSCRIPTION
  PROJECT
  MAINTENANCE
  RENEWAL
  NETWORK
  HARDWARE
  SOFTWARE
  SERVICE
  CONSULTING
  OTHER
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum TransactionType {
  OPENING_BALANCE
  PROPOSAL_DEBT
  INVOICE_DEBT
  PAYMENT_CREDIT
  INVOICE_CANCELLATION_CREDIT
  PAYMENT_CANCELLATION_DEBIT
  MANUAL_ADJUSTMENT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum InvoiceType {
  SALE
  RETURN
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  CANCELLED
}

enum SupplierPurchaseStatus {
  DUE
  PAID
  CANCELLED
}

enum SupplierTransactionType {
  PURCHASE_DEBT
  SUPPLIER_PAYMENT
  PURCHASE_CANCELLATION
}

// ============================================
// MODELS
// ============================================

// Müşteri modeli
model Customer {
  id                   String         @id @default(cuid())
  fullName             String
  firmaAdi             String?
  phoneNumber          String
  city                 String
  district             String
  club                 String
  sportsSchoolOfficial String
  hosting              String
  duration             String
  startDate            String
  endDate              String
  offer                String
  address              String
  status               CustomerStatus @default(POTENTIAL)
  price                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  notes                Note[]
  userAccounts         User[]
  subscriptions        Subscription[]
  domains              Domain[]
  hostings             Hosting[]
  tasks                Task[]
  payments             Payment[]
  notifications        Notification[]
  files                File[]
  proposals            Proposal[]

  // Muhasebe ilişkileri
  accountTransactions AccountTransaction[]
  invoices            Invoice[]

  // Açılış bakiyesi
  openingBalance     Decimal   @default(0)
  openingBalanceDate DateTime?

  @@map("customers")
}

// Yönetici kullanıcıları tablosu
model Admin {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       Role     @default(SUPPORT)
  customerId String?

  @@map("admins")
}

// Key-value ayarlar için Setting modeli
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model WebhookLog {
  id         String   @id
  event      String
  url        String
  ok         Boolean
  statusCode Int?
  error      String?
  attempt    Int
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@index([timestamp])
  @@index([event, ok])
  @@map("webhook_logs")
}

model WebhookQueue {
  id        String   @id
  dedupeKey String   @unique
  event     String
  url       String
  body      String   @db.Text
  secret    String?
  attempt   Int
  nextAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextAt])
  @@index([event])
  @@map("webhook_queue")
}

model Subscription {
  id               String             @id @default(cuid())
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId       String
  name             String
  type             SubscriptionType[]
  period           BillingPeriod
  startDate        DateTime
  endDate          DateTime
  autoRenew        Boolean            @default(false)
  status           SubscriptionStatus @default(ACTIVE)
  price            String
  installmentCount Int?
  proposalType     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  payments         Payment[]
  files            File[]

  @@map("subscriptions")
}

model Domain {
  id            String       @id @default(cuid())
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId String?      @unique
  name          String       @unique
  registerDate  DateTime
  renewDate     DateTime
  whoisNote     String?
  autoRenew     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  files         File[]

  @@map("domains")
}

model Hosting {
  id            String       @id @default(cuid())
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  invoiceItemId String?      @unique
  name          String
  endDate       DateTime
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  files         File[]

  @@map("hosting")
}

model Task {
  id          String        @id @default(cuid())
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  title       String
  description String
  status      TaskStatus    @default(OPEN)
  assignee    User?         @relation(fields: [assigneeId], references: [id])
  assigneeId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  comments    TaskComment[]
  files       File[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@map("task_comments")
}

model Payment {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  // Fatura ilişkisi
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  // Ödeme türü
  type PaymentType @default(CASH)

  // Tutar
  amount   Decimal
  currency String  @default("TRY")

  // Tarih
  date     DateTime
  dueDate  DateTime?
  paidDate DateTime?

  // Durum
  status PaymentStatus @default(DUE)

  // Açıklama
  note        String?
  description String?

  // Cari hareket ilişkisi
  accountTransactions AccountTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Notification {
  id          String              @id @default(cuid())
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  type        NotificationType
  channel     NotificationChannel
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  @@map("notifications")
}

model File {
  id             String        @id @default(cuid())
  url            String
  name           String
  type           String?
  size           Int?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId     String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId String?
  domain         Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainId       String?
  hosting        Hosting?      @relation(fields: [hostingId], references: [id], onDelete: SetNull)
  hostingId      String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId         String?
  createdAt      DateTime      @default(now())

  @@map("files")
}

model Proposal {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  // Teklif numarası
  number String @unique

  title       String
  type        ProposalType
  description String?
  amount      Decimal
  currency    String         @default("TRY")
  validUntil  DateTime
  status      ProposalStatus @default(DRAFT)

  // Gönderim bilgisi
  sentAt DateTime?

  // Onay bilgisi
  approvedBy String?
  approvedAt DateTime?

  // Red bilgisi
  rejectedAt   DateTime?
  rejectReason String?

  notes String?

  // Satırlar
  items ProposalItem[]

  // Fatura ilişkisi
  invoices Invoice[]

  // Cari hareket
  accountTransactions AccountTransaction[]

  // Stok hareket
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("proposals")
}

// ============================================
// MUHASEBE MODÜLLERİ
// ============================================

// Cari Hesap Hareketleri
model AccountTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Hareket türü
  type TransactionType

  // Borç/Alacak
  debit  Decimal @default(0)
  credit Decimal @default(0)

  // Bakiye (running balance)
  balance Decimal

  // İlişkiler
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id])

  // Açıklama
  description String?

  createdAt DateTime @default(now())

  @@map("account_transactions")
}

// Ürün Grubu
model ProductGroup {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  color       String    @default("#3b82f6")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("product_groups")
}

// Stok/Ürün Kartı
model Product {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  type        ProductType @default(PRODUCT)

  // Grup ilişkisi
  groupId String?
  group   ProductGroup? @relation(fields: [groupId], references: [id])

  // Stok takibi
  stockQuantity Decimal @default(0)
  minStockLevel Decimal @default(0)

  // Fiyat
  costPrice    Decimal?
  profitMargin Decimal? @default(0)
  unitPrice    Decimal
  currency     String   @default("TRY")

  // Stok hareketleri
  movements StockMovement[]

  // Teklif satırları
  proposalItems ProposalItem[]

  // Fatura satırları
  invoiceItems InvoiceItem[]

  // Tedarikçi alış kayıtları
  supplierPurchases SupplierPurchase[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// Stok Hareketleri
model StockMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     MovementType
  quantity Decimal

  // İlişkiler
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])

  description String?
  createdAt   DateTime @default(now())

  @@map("stock_movements")
}

// Teklif Detayları (Satırlar)
model ProposalItem {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal
  totalPrice  Decimal

  @@map("proposal_items")
}

// Fatura
model Invoice {
  id String @id @default(cuid())

  // Fatura numarası
  number         String  @unique
  idempotencyKey String? @unique

  // Müşteri
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Tekliften oluşturulduysa
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id])

  // Fatura türü
  type InvoiceType

  // Tutarlar
  subtotal  Decimal
  taxRate   Decimal @default(20)
  taxAmount Decimal
  total     Decimal

  // Durum
  status InvoiceStatus @default(DRAFT)

  // Tarihler
  issueDate DateTime
  dueDate   DateTime

  // Satırlar
  items InvoiceItem[]

  // Tahsilatlar
  payments Payment[]

  // Stok hareketleri
  stockMovements StockMovement[]

  // Cari hareket
  accountTransactions AccountTransaction[]

  // Operasyon ve alış izlenebilirliği
  domains           Domain[]
  hostings          Hosting[]
  supplierPurchases SupplierPurchase[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal
  unitPrice   Decimal
  totalPrice  Decimal

  domain           Domain?
  hosting          Hosting?
  supplierPurchase SupplierPurchase?

  @@map("invoice_items")
}

// ============================================
// SATIN ALMA VE TEDARİKÇİ MODÜLÜ
// ============================================

model Supplier {
  id        String  @id @default(cuid())
  name      String  @unique
  email     String?
  phone     String?
  taxNumber String?
  address   String?
  notes     String?
  isActive  Boolean @default(true)

  purchases           SupplierPurchase[]
  payments            SupplierPayment[]
  accountTransactions SupplierAccountTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

model SupplierPurchase {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceItemId String?      @unique
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description       String
  quantity          Decimal                @default(1)
  unitCost          Decimal
  taxRate           Decimal                @default(20)
  taxAmount         Decimal
  total             Decimal
  currency          String                 @default("TRY")
  purchaseDate      DateTime
  dueDate           DateTime?
  status            SupplierPurchaseStatus @default(DUE)
  supplierInvoiceNo String?
  note              String?

  payments            SupplierPayment[]
  accountTransactions SupplierAccountTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([invoiceId])
  @@index([productId])
  @@map("supplier_purchases")
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  purchaseId String?
  purchase   SupplierPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  type     PaymentType @default(CASH)
  amount   Decimal
  currency String      @default("TRY")
  paidDate DateTime
  note     String?

  accountTransactions SupplierAccountTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([purchaseId])
  @@map("supplier_payments")
}

model SupplierAccountTransaction {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  purchaseId String?
  purchase   SupplierPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paymentId  String?
  payment    SupplierPayment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  type        SupplierTransactionType
  debit       Decimal                 @default(0)
  credit      Decimal                 @default(0)
  balance     Decimal
  description String?
  createdAt   DateTime                @default(now())

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentId])
  @@map("supplier_account_transactions")
}

// User modeli
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String
  role      String   @default("USER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  assignedTasks Task[]
  comments      TaskComment[]

  @@map("users")
}

// Note modeli
model Note {
  id         String   @id @default(cuid())
  content    String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notes")
}
