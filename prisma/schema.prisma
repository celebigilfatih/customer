generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  POTENTIAL
  CONTACTED
  INTERESTED
  CONVERTED
  REJECTED
  SOLD
}

model Customer {
  id                   String         @id @default(cuid())
  fullName            String
  phoneNumber         String
  city                String
  district            String
  club                String
  sportsSchoolOfficial String
  hosting             String
  duration            String
  startDate           String
  endDate             String
  offer               String
  address             String
  status              CustomerStatus @default(POTENTIAL)
  price               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  notes               Note[]

  @@map("customers")
}

model Note {
  id         String   @id @default(cuid())
  content    String
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("notes")
}
